# Copy to .env.local and fill with real values. NEVER commit real secrets.

# ─── Database ───
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/regalia?retryWrites=true&w=majority

# ─── Auth (Auth.js v5) ───
# Local dev MUST use http://localhost:3000 (https here makes the CSRF cookie
# Secure, which the browser drops over http → MissingCSRF).
AUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=same-as-AUTH_SECRET
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# ─── Cloudinary ───
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Public ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_HOTEL_NAME=Regalia Resort

# ─── Web Push (VAPID) ───
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
